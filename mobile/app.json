{
  "expo": {
    "name": "FinanceApp",
    "slug": "finance-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "financeapp",
    "icon": "./assets/images/icon.png",
    "android": {
      "package": "com.financeapp.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#171A16",
        "monochromeImage": "./assets/images/monochrome-icon.png"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-splash-screen",
      "expo-status-bar",
      [
        "react-native-nitro-google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.REPLACE_WITH_IOS_CLIENT_ID"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "0111cb26-b0be-4302-b636-7b01b50a37cc"
      }
    },
    "owner": "hans2awesome"
  }
}
