# Copy to mobile/.env and point at your API.
# Expo inlines EXPO_PUBLIC_* values at build time, so restart `expo start` after
# changing it. Use your machine's LAN IP (not localhost) when testing on a phone.
EXPO_PUBLIC_API_URL=http://localhost:8000

# Google Android sign-in. The Web OAuth client ID, the same value the backend
# uses for GOOGLE_WEB_CLIENT_ID. Leave empty to hide Google on this build.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=