# FastAPI Backend Configuration
# Required. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ENVIRONMENT=development
ALGORITHM=HS256

# Short-lived access token plus long-lived refresh token.
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database. Leave DATABASE_URL empty to use the local SQLite file; set it to
# move both the API and the bot to PostgreSQL (Supabase).
#
# Supabase > Project Settings > Database > Connection string > URI:
#   DATABASE_URL=postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres?sslmode=require
# Port 6543 is the transaction pooler (recommended here); 5432 is the session
# pooler. Keep sslmode=require. The password must be URL-encoded.
DATABASE_URL=

# SQLite database file path. Only used when DATABASE_URL is empty. The bot and
# the API share this file. Must match the bot DATABASE_PATH. Paths resolve from
# the process working directory.
DATABASE_PATH=bot04.sqlite3

# Default user timezone and currency
TIMEZONE=Asia/Jakarta
CURRENCY=IDR

# Comma separated origins. Never use * with credentials in production.
# ENVIRONMENT=production refuses to start while this is still *.
CORS_ORIGINS=http://localhost:8081

# Comma separated proxy addresses allowed to set CF-Connecting-IP /
# X-Forwarded-For. Defaults to localhost (Cloudflare Tunnel terminates there).
# Keep this narrow: a trusted entry can spoof the client address.
TRUSTED_PROXIES=127.0.0.1,::1