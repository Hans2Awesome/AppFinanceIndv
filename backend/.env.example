# FastAPI Backend Configuration
SECRET_KEY=change-this-to-a-super-secret-random-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# SQLite database file path (shared or separate)
DATABASE_PATH=../bot04.sqlite3

# Default user timezone and currency
TIMEZONE=Asia/Jakarta
CURRENCY=IDR

# CORS allowed origins (comma separated or * for dev)
CORS_ORIGINS=*
